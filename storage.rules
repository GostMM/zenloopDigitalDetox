rules_version = '2';

// Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {

    // Règles pour le folder backgrounds/ - lecture publique
    match /backgrounds/{imageFile} {
      allow read: if true;  // ✅ Tout le monde peut lire les backgrounds
      allow write: if false; // ❌ Personne ne peut écrire (sauf via console)
    }

    // Règles pour les avatars utilisateurs
    match /avatars/{userId}/{imageFile} {
      allow read: if true;  // ✅ Lecture publique
      allow write: if request.auth != null && request.auth.uid == userId; // ✅ Écriture uniquement par le propriétaire
    }

    // Par défaut: accès refusé
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
